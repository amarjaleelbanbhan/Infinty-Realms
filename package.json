{
  "name": "infinity-realms",
  "version": "0.1.0",
  "private": true,
  "description": "A never-ending browser RPG with procedural worlds, AI NPCs, and infinite replayability",
  "workspaces": [
    "client",
    "server",
    "shared",
    "ai"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=shared && npm run build --workspace=ai && npm run build --workspace=client && npm run build --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rimraf **/node_modules **/dist **/build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
